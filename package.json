{
  "name": "deevo-monitor",
  "version": "1.0.0",
  "description": "Real-time GCC intelligence dashboard — AI-powered insurance risk monitoring, geopolitical tracking, and infrastructure surveillance for Gulf Cooperation Council markets",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:insurance": "VITE_VARIANT=insurance vite",
    "dev:geopolitical": "VITE_VARIANT=geopolitical vite",
    "dev:finance": "VITE_VARIANT=finance vite",
    "build": "tsc && vite build",
    "build:full": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "proto:gen": "buf generate proto/"
  },
  "dependencies": {
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/layers": "^9.1.0",
    "@deck.gl/geo-layers": "^9.1.0",
    "@deck.gl/mesh-layers": "^9.1.0",
    "@deck.gl/aggregation-layers": "^9.1.0",
    "@loaders.gl/core": "^4.3.0",
    "@loaders.gl/csv": "^4.3.0",
    "@loaders.gl/json": "^4.3.0",
    "maplibre-gl": "^4.7.0",
    "globe.gl": "^2.35.0",
    "three": "^0.170.0",
    "chart.js": "^4.4.0",
    "d3": "^7.9.0",
    "rss-parser": "^3.13.0",
    "date-fns": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "@types/three": "^0.170.0",
    "@types/d3": "^7.4.0",
    "eslint": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0"
  },
  "author": "BDRAI <bader.marketing.39@gmail.com>",
  "license": "AGPL-3.0",
  "homepage": "https://deevomonitor.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/PyBADR/deevo-monitor.git"
  },
  "keywords": [
    "gcc",
    "insurance",
    "risk-monitoring",
    "geopolitical",
    "osint",
    "ai",
    "dashboard",
    "deevo",
    "gulf",
    "saudi-arabia",
    "uae",
    "qatar",
    "kuwait",
    "bahrain",
    "oman",
    "real-time",
    "intelligence",
    "ollama"
  ]
}
