{
  "name": "deevo-monitor",
  "version": "5.1.0",
  "private": true,
  "type": "module",
  "description": "GCC Insurance Intelligence Dashboard — Real-time risk monitoring with DeckGL, AI-powered insights, and geopolitical tracking for Gulf Cooperation Council markets",
  "scripts": {
    "dev": "vite --port 5174",
    "dev:tech": "VITE_VARIANT=tech vite --port 5175",
    "dev:finance": "VITE_VARIANT=finance vite --port 5176",
    "dev:commodity": "VITE_VARIANT=commodity vite --port 5177",
    "dev:happy": "VITE_VARIANT=happy vite --port 5178",
    "dev:fraud": "VITE_VARIANT=fraud vite --port 5179",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:tech\" \"npm run dev:finance\"",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "server": "tsx watch server/index.ts",
    "build": "vite build",
    "build:full": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.1.0",
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/geo-layers": "^9.1.0",
    "@deck.gl/layers": "^9.1.0",
    "@deck.gl/react": "^9.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.94.5",
    "axios": "^1.13.6",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "globe.gl": "^2.35.1",
    "three": "^0.170.0",
    "i18next": "^24.2.2",
    "react-i18next": "^15.4.1",
    "ioredis": "^5.6.1",
    "immer": "^11.1.4",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^7.1.7",
    "react-router-dom": "^7.13.1",
    "recharts": "^2.15.0",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "author": "BDRAI <bader.marketing.39@gmail.com>",
  "license": "AGPL-3.0",
  "homepage": "https://deevomonitor.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/PyBADR/deevo-monitor.git"
  }
}
