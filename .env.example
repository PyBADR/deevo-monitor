# ─── DEEVO Intelligence Monitor — Environment Variables ───
# Contract C9 / Task 9D
# Copy to .env and fill in values for local development.

# Vercel auto-sets these in production:
# VERCEL_ENV=production
# VERCEL_REGION=cdg1
# VERCEL_URL=deevo-monitor.vercel.app

# ─── RSS Proxy ────────────────────────────────────────────
# Override default CORS proxy URL (optional)
# VITE_RSS_PROXY_URL=/api/rss-proxy?url={url}

# ─── Feature Flags ────────────────────────────────────────
# VITE_ENABLE_ARABIC=true
# VITE_ENABLE_PDPL_BANNER=true

# ─── Analytics (future) ──────────────────────────────────
# VITE_POSTHOG_KEY=
# VITE_SENTRY_DSN=

# ─── AI Backend (future — Ollama on Mac M4 Max) ──────────
# VITE_OLLAMA_URL=http://localhost:11434
# VITE_LLM_MODEL=llama3.1:70b
