# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# API Server
VITE_API_URL=http://localhost:3001
API_PORT=3001

# Map (CartoDB dark basemap — no key needed)
# For MapTiler premium styles, set:
# VITE_MAPTILER_KEY=your_maptiler_key_here

# Cortex (DeevoAnalytics backend)
CORTEX_URL=http://localhost:8010/api/v1/cortex
CORTEX_TOKEN=dev-token
CORTEX_TENANT=default

# Optional: NewsAPI for live feeds
# NEWS_API_KEY=your_newsapi_key_here
