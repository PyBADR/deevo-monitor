{
  "$schema": "https://raw.githubusercontent.com/nicholasio/tauri/2.0/packages/api/schema/tauri.schema.json",
  "productName": "Deevo Monitor",
  "version": "4.1.0",
  "identifier": "com.deevo.monitor",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "title": "Deevo Monitor — AI Decision Intelligence",
    "windows": [
      {
        "title": "Deevo Monitor v4.1",
        "width": 1600,
        "height": 1000,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "minWidth": 1200,
        "minHeight": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: http://localhost:* ws: wss: blob: data:; img-src 'self' data: blob: https:; worker-src 'self' blob:; font-src 'self' data: https:; media-src 'self' data: blob: https: http://localhost:*; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://webcams.windy.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "signingIdentity": null
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "sidecar": [
        {
          "cmd": "node",
          "args": ["server/index.ts"],
          "env": {
            "PORT": "3001"
          }
        }
      ]
    },
    "updater": {
      "endpoints": ["https://releases.deevomonitor.app/{{target}}/{{arch}}/{{current_version}}"],
      "dialog": true,
      "pubkey": ""
    }
  }
}
