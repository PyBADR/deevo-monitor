{
  "$schema": "https://raw.githubusercontent.com/nicedoc/logos/master/src/tauri-apps/tauri.config.v2.schema.json",
  "productName": "Deevo Monitor",
  "version": "1.0.0",
  "identifier": "app.deevomonitor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Deevo Monitor — GCC Intelligence Dashboard",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' http://localhost:* https://*.cartocdn.com https://*.maplibre.org https://*.googleapis.com ws://localhost:*"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Deevo Monitor"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "BDRAI - Deevo Analytics",
    "category": "Business",
    "shortDescription": "GCC Intelligence Dashboard",
    "longDescription": "Real-time GCC intelligence dashboard with AI-powered insurance risk monitoring, geopolitical tracking, and infrastructure surveillance for Gulf Cooperation Council markets.",
    "copyright": "Copyright 2026 BDRAI - Deevo Analytics",
    "license": "AGPL-3.0",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["English", "Arabic"],
        "installMode": "both"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "shell": {
      "sidecar": true,
      "scope": [
        {
          "name": "node-server",
          "cmd": "node",
          "args": ["server/index.ts"]
        }
      ]
    }
  }
}
